# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SPREADSHEET_ID: The private Google Sheets document ID (from its URL)
GOOGLE_SPREADSHEET_ID="11rBhezcklOndIPa7YAHr3zIBh6WCXkp2235slmirnlI"

# GOOGLE_APPS_SCRIPT_URL: Deployed Google Apps Script Web App URL ending in /exec
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec"

# GOOGLE_SHEETS_SHARED_SECRET: Strong secret key matching Script Property "API_SECRET" in Google Apps Script
# Used by the Node.js backend to generate HMAC-SHA256 request signatures
GOOGLE_SHEETS_SHARED_SECRET="replace_with_strong_random_secret_passphrase"

# DOCTOR_SPREADSHEET_ID: The private Google Sheets document ID for the Doctor workspace (when connected)
# Left empty until the Doctor's workbook is provided and configured
DOCTOR_SPREADSHEET_ID=""

# DOCTOR_APPS_SCRIPT_URL: Optional separate Google Apps Script URL for Doctor workspace if using a distinct script
DOCTOR_APPS_SCRIPT_URL=""

# SESSION_SECRET: Secret key for signing staff sessions
SESSION_SECRET="mk_eye_center_secure_jwt_secret_token"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

